{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/cursor-fx\" signal >/dev/null 2>&1 || true",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/cursor-fx\" signal done >/dev/null 2>&1 || true",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ]
  }
}
